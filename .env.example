# Copy to .env. Never commit production secrets.
PORT=4000
NODE_ENV=development
DATABASE_URL="postgresql://forme:forme_dev_password@localhost:5432/forme?schema=public"
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-characters"
ADMIN_EMAIL="admin@example.com"
# Change this before you expose the app to anything. The account is created
# on first boot with these values.
ADMIN_PASSWORD="change-me-before-you-deploy"
CORS_ORIGIN="http://localhost:8080,http://127.0.0.1:8080"
# Provider choices intentionally remain unconfigured until a legal entity and provider are selected.
PAYMENT_PROVIDER=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=
SHIPPING_PROVIDER=
SHIPPING_API_KEY=
EMAIL_PROVIDER_API_KEY=
# Optional merchant estimates only; these are NOT carrier quotes.
SHIPPING_ESTIMATE_US=0
SHIPPING_ESTIMATE_CA=
SHIPPING_ESTIMATE_GB=
SHIPPING_ESTIMATE_FR=
SHIPPING_ESTIMATE_DE=
SHIPPING_ESTIMATE_ES=
